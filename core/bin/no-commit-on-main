#!/usr/bin/env python3
# PreToolUse hook (Bash), named in core's managed settings: blocks
# "git commit" while the repo is on main. Exit 2 blocks the command and
# tells Claude why. A command that first creates a branch (git switch -c /
# git checkout -b) is let through.
import json, re, subprocess, sys

data = json.load(sys.stdin)
cmd = data.get("tool_input", {}).get("command", "")
# "git" where a command starts (line start, after ; & | ( { ! or $(, or
# after then, do, else, command or exec), after any VAR=value words and a
# path (/usr/bin/git), then global options (-C dir, -c key=value, -x),
# then the subcommand.
GIT = (r"(?:^|[;&|({\n!]|\$\(|\b(?:then|do|else|command|exec)\s)\s*(?:\w+=\S*\s+)*(?:\S*/)?"
       r"git(?:\s+-[Cc]\s+\S+|\s+-\S+)*\s+")
if not re.search(GIT + r"commit\b", cmd):
    sys.exit(0)
if re.search(GIT + r"(?:switch|checkout)(?:\s+-[^\scb]\S*)*\s+-[cb]\b", cmd):
    sys.exit(0)
branch = subprocess.run(["git", "branch", "--show-current"], cwd=data.get("cwd") or ".",
                        capture_output=True, text=True).stdout.strip()
if branch == "main":
    print("Blocked: this repo is on main. Commit on a claude/<topic> branch "
          "(git switch -c claude/<topic>) instead.", file=sys.stderr)
    sys.exit(2)
